# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file
# The Dockerfile copies only go.mod, go.sum, cmd/main.go, api/ and internal/.
# Everything else is excluded to keep the build context small and cache-friendly.

# Local build outputs and tooling
bin/
dist/
*.out
.claude/

# VCS and CI metadata
.git
.github/
.devcontainer/

# Not needed to build the manager image
test/
config/
hack/
docs/
*.md
